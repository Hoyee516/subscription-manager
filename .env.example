# Copy to .env (Prisma CLI) AND .env.local (Next.js). Never commit either.

# Neon — pooled connection for Prisma (host contains "-pooler", includes connect_timeout=15)
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?connect_timeout=15&sslmode=require"
# Neon — direct connection (no "-pooler"), used by `prisma db push`
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Seed only (prisma/seed.ts) — your login for this app
SEED_USERNAME="hoyee"
SEED_PASSWORD=""
