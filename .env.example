# Copy to .env (Prisma CLI) AND .env.local (Next.js). Never commit either.

# Neon — pooled connection (host contains "-pooler")
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Neon — direct connection (no "-pooler"), used by `prisma db push`
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Seed only (prisma/seed.ts) — your login for this app
SEED_USERNAME="hoyee"
SEED_PASSWORD=""
