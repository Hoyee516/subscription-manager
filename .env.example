# Copy to .env (Prisma CLI) AND .env.local (Next.js). Never commit either.

# Neon — pooled connection for Prisma (host contains "-pooler", includes connect_timeout=15)
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?connect_timeout=15&sslmode=require"
# Neon — direct connection (no "-pooler"), used by `prisma db push`
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Seed only (prisma/seed.ts) — your login for this app
SEED_USERNAME="hoyee"
SEED_PASSWORD=""

# Google Calendar (reminders) — service account; share your calendar with its email
# ("Make changes to events"). Paste the private_key from the JSON key file, keeping the \n.
GOOGLE_SERVICE_ACCOUNT_EMAIL="name@project-id.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID="you@gmail.com"

# Daily cron (/api/cron/daily) — any long random string; Vercel sends it automatically
CRON_SECRET=""

# Link back to the app in calendar event descriptions (optional on Vercel)
APP_URL="https://your-app.vercel.app"
